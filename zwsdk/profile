ifeq ($(PRODUCT_TYPE),)
    PRODUCT_TYPE=P3MU
endif

#DEBUG=true

#开启图像调试(图像调试模式下，需要抓raw图，为节省内存：只使能主码流通道，不开启算法，二维码扫描)
#其他修改：1、需要替换vi库 2、nmem内存需要加大 3、由于子码流无流，中间层需关闭监测子码流无流看门狗重启逻辑
ENABLE_ISP_IMAGE_DEBUG=no
#支持多通道出流
IS_SUPPORT_MULIT_CHANNEL=yes
DEVICE_SUPPORT_CHANNEL_NUM=4
#使用循环流缓冲队列
USE_CIRCLEQUEUE=yes
#支持4G
IS_SUPPORT_4G_MODULE=no
#4G相关：支持普通号段为运营号段
IS_SUPPORT_COMMON_DID_OPREATE=no
#使用数字变倍
IS_SUPPORT_ZOOM=no
#Sensor降帧自适应
IS_SUPPORT_ADUJUST_SENSOR_FRAME=no
#支持产测定制音频文件
IS_SUPPORT_PRODUCT_TEST_CUSTOM_SPEECH_FILES=no
#支持老化测试
IS_SUPPORT_AGINGTEST=yes
#支持老化测试
IS_SUPPORT_SMARTP=no
#支持长短焦切换
IS_SUPPORT_LONG_SHORT_FOCUS_ZOOM=no
#平台
TYPE=Hi3516CV610
#是否支持60HZ改为12帧
IS_SUPPORT_12FPS=no
#一键呼叫
IS_SUPPORT_ONE_CLICK_CALL=no
#支持多通道算法
IS_SUPPORT_MULIT_CHANNEL_HD_ALGO=no
DEVICE_SUPPORT_HD_ALGO_CHANNEL_NUM=1
#支持哭声检测，一个海思的一个君正，海思大150k左右。
IS_SUPPORT_HS_CRY_DETECT=no
IS_SUPPORT_JZ_CRY_DETECT=no
#支持LCD显示屏和VDEC解码
IS_SUPPORT_LCD_MANAGER=no

ifeq ($(PRODUCT_TYPE),W85T)
    SUPPORT_WIFI_FUNC=yes
    IS_SUPPORT_ZOOM=yes
    IS_SUPPORT_PRODUCT_TEST_CUSTOM_SPEECH_FILES=yes
    IS_SUPPORT_LONG_SHORT_FOCUS_ZOOM=yes
    IS_SUPPORT_MULIT_CHANNEL_HD_ALGO=yes
    DEVICE_SUPPORT_HD_ALGO_CHANNEL_NUM=4
else ifeq ($(PRODUCT_TYPE),G85T)
    SUPPORT_WIFI_FUNC=no
    #支持4G
    IS_SUPPORT_4G_MODULE=yes
    IS_SUPPORT_PRODUCT_TEST_CUSTOM_SPEECH_FILES=yes
    IS_SUPPORT_ZOOM=yes
    IS_SUPPORT_SMARTP=yes
    IS_SUPPORT_LONG_SHORT_FOCUS_ZOOM=yes
    IS_SUPPORT_MULIT_CHANNEL_HD_ALGO=yes
    DEVICE_SUPPORT_HD_ALGO_CHANNEL_NUM=4
else ifeq ($(PRODUCT_TYPE),P4)
    SUPPORT_WIFI_FUNC=yes
    IS_SUPPORT_ZOOM=yes
    IS_SUPPORT_PRODUCT_TEST_CUSTOM_SPEECH_FILES=yes
    DEVICE_SUPPORT_CHANNEL_NUM=1
    IS_SUPPORT_MULIT_CHANNEL_HD_ALGO=yes
    DEVICE_SUPPORT_HD_ALGO_CHANNEL_NUM=1
    TYPE=Hi3516CV608
    IS_SUPPORT_ADUJUST_SENSOR_FRAME=yes
    IS_SUPPORT_12FPS=yes
    IS_SUPPORT_ONE_CLICK_CALL=yes
    IS_SUPPORT_JZ_CRY_DETECT=yes
else ifeq ($(PRODUCT_TYPE),P3MU)
    SUPPORT_WIFI_FUNC=yes
    IS_SUPPORT_ZOOM=yes
    IS_SUPPORT_PRODUCT_TEST_CUSTOM_SPEECH_FILES=yes
    DEVICE_SUPPORT_CHANNEL_NUM=1
    IS_SUPPORT_MULIT_CHANNEL_HD_ALGO=yes
    DEVICE_SUPPORT_HD_ALGO_CHANNEL_NUM=1
    TYPE=Hi3516CV608
    IS_SUPPORT_ADUJUST_SENSOR_FRAME=yes
    IS_SUPPORT_12FPS=yes
    IS_SUPPORT_ONE_CLICK_CALL=yes
    IS_SUPPORT_JZ_CRY_DETECT=yes
    IS_SUPPORT_LCD_MANAGER=yes
else ifeq ($(PRODUCT_TYPE),G43TA)
    TYPE=Hi3516CV608
    SUPPORT_WIFI_FUNC=no
    #支持4G
    IS_SUPPORT_4G_MODULE=yes
    IS_SUPPORT_PRODUCT_TEST_CUSTOM_SPEECH_FILES=yes
    IS_SUPPORT_ZOOM=yes
    IS_SUPPORT_LONG_SHORT_FOCUS_ZOOM=yes
    IS_SUPPORT_MULIT_CHANNEL_HD_ALGO=yes
    DEVICE_SUPPORT_CHANNEL_NUM=2
    DEVICE_SUPPORT_HD_ALGO_CHANNEL_NUM=1
    IS_SUPPORT_ONE_CLICK_CALL=yes
    IS_SUPPORT_HS_CRY_DETECT=yes
else ifeq ($(PRODUCT_TYPE),P4U)
    SUPPORT_WIFI_FUNC=yes
    IS_SUPPORT_ZOOM=yes
    IS_SUPPORT_PRODUCT_TEST_CUSTOM_SPEECH_FILES=yes
    DEVICE_SUPPORT_CHANNEL_NUM=1
    IS_SUPPORT_MULIT_CHANNEL_HD_ALGO=yes
    DEVICE_SUPPORT_HD_ALGO_CHANNEL_NUM=1
    TYPE=Hi3516CV608
    IS_SUPPORT_ADUJUST_SENSOR_FRAME=yes
    IS_SUPPORT_12FPS=yes
    IS_SUPPORT_ONE_CLICK_CALL=yes
    IS_SUPPORT_JZ_CRY_DETECT=yes
else ifeq ($(PRODUCT_TYPE),G84F)
    SUPPORT_WIFI_FUNC=no
    #支持4G
    IS_SUPPORT_4G_MODULE=yes
    IS_SUPPORT_PRODUCT_TEST_CUSTOM_SPEECH_FILES=yes
    IS_SUPPORT_ZOOM=yes
    DEVICE_SUPPORT_CHANNEL_NUM=4
    IS_SUPPORT_MULIT_CHANNEL_HD_ALGO=yes
    DEVICE_SUPPORT_HD_ALGO_CHANNEL_NUM=4
else ifeq ($(PRODUCT_TYPE),W84F)
    SUPPORT_WIFI_FUNC=yes
    IS_SUPPORT_PRODUCT_TEST_CUSTOM_SPEECH_FILES=yes
    IS_SUPPORT_ZOOM=yes
    DEVICE_SUPPORT_CHANNEL_NUM=4
    IS_SUPPORT_MULIT_CHANNEL_HD_ALGO=yes
    DEVICE_SUPPORT_HD_ALGO_CHANNEL_NUM=4
else ifeq ($(PRODUCT_TYPE),G63F)
    SUPPORT_WIFI_FUNC=no
    #支持4G
    IS_SUPPORT_4G_MODULE=yes
    IS_SUPPORT_PRODUCT_TEST_CUSTOM_SPEECH_FILES=yes
    IS_SUPPORT_ZOOM=yes
    DEVICE_SUPPORT_CHANNEL_NUM=3
    IS_SUPPORT_MULIT_CHANNEL_HD_ALGO=yes
    DEVICE_SUPPORT_HD_ALGO_CHANNEL_NUM=3
else ifeq ($(PRODUCT_TYPE),W63F)
    SUPPORT_WIFI_FUNC=yes
    IS_SUPPORT_PRODUCT_TEST_CUSTOM_SPEECH_FILES=yes
    IS_SUPPORT_ZOOM=yes
    DEVICE_SUPPORT_CHANNEL_NUM=3
    IS_SUPPORT_MULIT_CHANNEL_HD_ALGO=yes
    DEVICE_SUPPORT_HD_ALGO_CHANNEL_NUM=3    
endif

