#!/bin/sh

source /etc/profile

dev_name=
dev_hwid=
snr_name=

find_devid()
{
	PROC_DEVINFO=/proc/xrs/devinfo
	dev_hwid=`cat $PROC_DEVINFO | grep HWID: | awk '{print $2}'`
	dev_quick_start=`cat $PROC_DEVINFO | grep quick_start: | awk '{print $2}'`
	echo "dev_hwid: "$dev_hwid "quick_start: "$dev_quick_start
	export DEV_QUICK_START=$dev_quick_start
}

find_devtype()
{
	PROC_HWCONF=/proc/xrs/hwconf
	dev_name=`cat $PROC_HWCONF | grep BOARD: | awk '{print $2}'`
	snr_name=`cat $PROC_HWCONF | grep SENSOR: | awk '{print $2}'`
	echo "dev_name: "$dev_name "snr_name: "$snr_name
}

check_devinfo()
{
	DEVINFO_VER=/mnt/app/device/DeviceVersion.ini
	DEVINFO_LIST=/mnt/app/device/DeviceType.txt
	ENV_BOARD_TYPE=boardtype
	ENV_BOARD_VER=boardver

	major=`readini $DEVINFO_VER Software Major_version`
	minor=`readini $DEVINFO_VER Software Minor_version`
	rever=`readini $DEVINFO_VER Software Reversion`
	date=`readini $DEVINFO_VER Software BuildDate`

	version=V${major}.${minor}.${rever}_${date}
	devtype=` head -n 1 $DEVINFO_LIST | cut -b 6-`

	# if [ "`fw_printenv $ENV_BOARD_TYPE | awk -F= '{print $2}'`"x != "$devtype"x ]; then
	# 		fw_setenv $ENV_BOARD_TYPE $devtype
	# 		echo "Set $ENV_BOARD_TYPE $devtype"
	# fi

	if [ "`fw_printenv $ENV_BOARD_TYPE`"x == ""x ]; then
			fw_setenv $ENV_BOARD_TYPE $devtype
			echo "Set $ENV_BOARD_TYPE $devtype"
	fi

	if [ "`fw_printenv $ENV_BOARD_VER | awk -F= '{print $2}'`"x != "$version"x ]; then
			fw_setenv $ENV_BOARD_VER $version
			echo "Set $ENV_BOARD_VER $version"
	fi
}

load_diff_modules()
{
	case $dev_name in
	T4)
		;;
	*)
		i=1
		while [ $i -le 3 ]; do
			echo "load diff modules, unsupported dev_name: "$dev_name > /dev/kmsg
			sleep 1
			let i+=1
		done
		;;
	esac
}


