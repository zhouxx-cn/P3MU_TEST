# !/bin/bash

CONFIG=${1}
CONFIG_FILE=ifcfg-${CONFIG}
WCLI=/usr/sbin/wpa_cli

# load interface config file
if [ ! -f /etc/network/${CONFIG_FILE} ] ; then
  echo "not search ${CONFIG_FILE} file"
  exit 1;
fi
. /etc/network/${CONFIG_FILE}

# check root user priority
if [ "$USER" != "root" ] ; then
  echo "only the root can start the device ${CONFIG}"
  exit 1;
fi

# start wpa_supplicant first
killall -9 wpa_supplicant
ifconfig ${CONFIG} up
cp -f /mnt/mtd/etc/wifi/wpa.conf /tmp/
if [ "${CONFIG}" == "ra0" ] ; then
    echo "ra0"
	/usr/sbin/wpa_supplicant -B -i${CONFIG} -c/tmp/wpa.conf -Dwext
else
	/usr/sbin/wpa_supplicant -B -i${CONFIG} -c/tmp/wpa.conf -Dnl80211
fi

echo "wireless configurate"

is_number()
{
	tst=`expr $1 : "[0-9]*$"`
	if [ $tst -eq 0 ]; then
		#echo "string"
		return 0;
	else
		#echo "number"
		return 1;
	fi
}

# Infra OPEN Mode
infra_open_mode()
{
	echo "infra_open_mode"
	echo "# !/bin/bash" >> /tmp/wireless_conf
	echo "$WCLI remove_network 0" >> /tmp/wireless_conf
	echo "$WCLI ap_scan 1" >> /tmp/wireless_conf
	echo "$WCLI add_network" >> /tmp/wireless_conf
	echo "$WCLI set_network 0 ssid '\"$ESSID\"'" >> /tmp/wireless_conf
	echo "$WCLI set_network 0 key_mgmt NONE" >> /tmp/wireless_conf
	echo "$WCLI select_network 0" >> /tmp/wireless_conf
}

