echo "......"
echo ${AUTH}
if [ "${AUTH}" == "OPEN" ] ; then
	if [ "${NETWORKTYPE}" == "Infra" ]; then
		infra_open_mode
	else
		adhoc_open_mode
	fi
elif [ "${AUTH}" == "SHARED" ]; then
	if [ "${NETWORKTYPE}" == "Infra" ]; then
		if [ "${ENC}" == "NONE" ]; then
			infra_wep_open
		else
			infra_wep_share
		fi
	else
		adhoc_wep_mode
	fi
elif [ "${AUTH}" == "WEPAUTO" ]; then
	if [ "${NETWORKTYPE}" == "Infra" ]; then
		infra_wep_share
	else
		adhoc_wep_mode
	fi
else
	echo ${NETWORKTYPE}
	if [ "${NETWORKTYPE}" == "Infra" ]; then
		infra_wpa_mode
	else
		infra_open_mode
	fi
fi

# start wifi
chmod 777 /tmp/wireless_conf
CONFIG_ERR=`/tmp/wireless_conf | grep 'FAIL'`
rm -f /tmp/wireless_conf
$WCLI -i ${CONFIG} save_config

echo "run result: " $CONFIG_ERR
if [ "${CONFIG_ERR}" == "FAIL" ] ; then
  echo "invalid parameter" > /var/wifi_connect_stauts.log
	exit 1
fi

function poke {
  while true
  do
    printf '\n'
    sleep 1
  done
}

checktime=1
function connect_watch {
  (poke) | $WCLI | while read line
  do
    checktime=$((${checktime} + 1))
    #echo $checktime
    if [ $checktime == 45 ] ; then
      echo "command timeout" > /var/wifi_connect_stauts.log
      killall wpa_cli
      return 1
    fi
    echo $line
    case "$line" in
      *'4-Way Handshake failed'*)
        echo "incorrect key"
        echo "incorrect password" > /var/wifi_connect_stauts.log
        killall wpa_cli
        return 1
      ;;
      *'CTRL-EVENT-CONNECTED'*)
        echo "connected"
        echo "connected" > /var/wifi_connect_stauts.log
        killall wpa_cli
        return 0
      ;;
    esac
  done
}

connect_watch
if [ $? -eq 1 ] ; then
  $WCLI remove_network 0
  exit 1
fi

# clear eth0 ip
ifconfig eth0 0.0.0.0

/etc/network/ifup ${CONFIG}
