#!/bin/sh

DEV_NAME=$1
DEV_TYPE=$2

echo "------------load media---------------"

# DDR start:    0x40000000
# 192K, FDT&ATF mem
# kernel start: 0x40030000
# 64M, os mem
# MMZ start:    0x44030000
# 64M - 128K, mmz mem

SNS_TYPE0=os04d10;               # sensor type
SNS_TYPE1=os04d10;               # sensor type

mmz_start=0x43000000;         # mmz start addr, default:0x42000000 (0x40000000+0x2000000(OS))
mmz_size=16384K;               # mmz size, default:96M (128M-32M)
SYS_PROFILE=0
IR_AUTO=1
BOARD=dmeb;                      # sck dmeb

report_error()
{
    echo "******* Error: There's something wrong, please check! *****"
    exit 1
}

start_logd()
{
	/usr/etc/axsyslogd start
	/usr/etc/axklogd start
}

function insert_security_subsys()
{
    insmod ot_cipher.ko
    insmod ot_km.ko
}

function remove_security_subsys()
{
    rmmod ot_km.ko
    rmmod ot_cipher.ko
}

function insert_gyro()
{
    insmod extdrv/ot_spi.ko spi=1
    insmod ot_gyrodis.ko
    insmod ot_motionfusion.ko
    insmod extdrv/motionsensor_mng.ko
    insmod extdrv/motionsensor_chip.ko
}

