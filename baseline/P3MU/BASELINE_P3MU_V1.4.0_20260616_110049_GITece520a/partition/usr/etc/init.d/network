#!/bin/sh

CWD=`pwd`
cd /etc/network/

# check available
is_available()
{
  LC_ALL= LANG= ip -o link | grep -q $1 && return 0 || return 1
}

# find all the interfaces besides loopback.such as eth1 lo 
# ignore aliases, alternative configurations, and editor backup files
interfaces=`ls ifcfg* | \
    LANG=C sed -e '/ifcfg-lo/d' -e '{ s/^ifcfg-//g}' | \
    LANG=C sort -k 1,1 -k 2n | \
    LANG=C sed 's/ //'`

case "$1" in
  start)
    # bring up loopback interface
    echo "Bringing up loopback interface:"
    /etc/network/ifup lo       
    # bring up all other interface configured to come up at boot time
    for i in $interfaces ; do
      if [ "$i" != "bond0" ] && [ "$i" != "ra0" ] && [ "$i" != "wlan0" ] ; then
        echo "Bring up interface $i:"
        /etc/network/ifup $i
      else
        echo "Bring up interface $i: Ignore"
      fi
    done
    ;;
  stop)
    # bring doun loopback interface
    echo "Bring down loopback interface:" 
    /etc/network/ifdown lo
    # bring down all other interface configured to come up at boot time
    for i in $interfaces ; do
      echo "Bring down interface $i:" 
    /etc/network/ifdown $i 
    done
    ;;
  status)
    echo $"Configured devices:"
    echo lo $interfaces
    echo $"Currently active devices:"
    echo $(ip -o link show up | awk -F ": " '{ print $2 }')
    ;;
  restart|reload)
    cd "$CWD"
    $0 stop
    $0 start
    ;;
  startwifi)
    is_available ra0 && /usr/etc/network/ifup-wireless ra0
    is_available wlan0 && /usr/etc/network/ifup-wireless wlan0
    ;;
  stopwifi)
    /usr/etc/network/ifdown-wireless ra0
    /usr/etc/network/ifdown-wireless wlan0
    ;;
  *)
    echo $"Usage: $0 {start|stop|restart|reload|status|startwifi|stopwifi}"
    exit 1
esac

exit 0
